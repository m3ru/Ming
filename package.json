{
  "name": "cedar-mastra-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- node scripts/dev.mjs",
    "dev:next": "next dev --turbopack --hostname 127.0.0.1",
    "dev:mastra": "npm --prefix src/backend run dev --",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test:voice": "node scripts/test-voice.mjs",
    "test:demo": "node --test tests/backend-streaming.test.mjs tests/report-optimization.test.mjs tests/chat-controls.test.mjs tests/demo-completion.test.mjs tests/hooks-cleanup.test.mjs src/lib/tests/report-regression.test.mjs",
    "pretty": "npx prettier --write .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:providers": "node --test tests/text-providers.test.mjs",
    "test:deepgram": "node --test tests/deepgram-backend.test.mjs tests/deepgram-voice.test.mjs",
    "test:adaptive": "node --test tests/adaptive-scenario.test.mjs tests/practice-session.test.mjs src/lib/tests/follow-up.test.mjs",
    "test:avatar": "node --test tests/live-avatar.test.mjs"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/react": "^3.4.2",
    "cedar-os": "^0.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.11",
    "lucide-react": "^0.532.0",
    "motion": "^12.23.12",
    "motion-plus-react": "^1.5.1",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "simli-client": "3.1.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.1",
    "dotenv-cli": "^7.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.2.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.31",
    "framer-motion": "$framer-motion",
    "motion-plus-react": "$motion-plus-react"
  }
}
